{
  "name": "payload-dynamic-forms",
  "version": "0.5.0",
  "description": "Forms for Payload CMS 3: sections, steps, show/hide rules checked on the server, spam checks, attachments, email, WhatsApp and webhook delivery. No visitor UI.",
  "license": "MIT",
  "author": "Kairos Software Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kairos-Software-Solutions/payload-dynamic-forms.git"
  },
  "homepage": "https://github.com/Kairos-Software-Solutions/payload-dynamic-forms#readme",
  "bugs": {
    "url": "https://github.com/Kairos-Software-Solutions/payload-dynamic-forms/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "forms",
    "form-builder",
    "cloudflare-workers",
    "turnstile",
    "whatsapp",
    "webhooks"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/exports/shared.d.ts",
      "import": "./dist/exports/shared.js",
      "default": "./dist/exports/shared.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:types && yarn build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "check:packed": "node scripts/check-packed.mjs",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "dev": "next dev dev --turbo",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "yarn dev:payload generate:importmap",
    "generate:types": "yarn dev:payload generate:types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 openspec validate --all --strict",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fission-ai/openspec": "1.17.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "graphql": "^16.15.0",
    "jsdom": "31.0.0",
    "next": "16.4.6",
    "open": "^11.0.4",
    "payload": "3.93.0",
    "prettier": "^3.10.0",
    "qs-esm": "8.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.4",
    "sort-package-json": "^4.1.0",
    "standardwebhooks": "1.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.92.1",
    "payload": "^3.92.1",
    "react": "^19.2.1"
  },
  "resolutions": {
    "@esbuild-kit/core-utils/esbuild": "0.25.12",
    "@eslint/js": "9.39.5",
    "@swc/cli/minimatch": "11.0.8",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript-eslint/typescript-estree/minimatch": "11.0.8",
    "eslint": "9.39.5",
    "eslint-plugin-import-x/minimatch": "11.0.8",
    "eslint-plugin-perfectionist/minimatch": "11.0.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.18.1"
}
