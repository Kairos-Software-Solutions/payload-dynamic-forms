{
  "name": "@kairos-software-solutions/payload-forms",
  "version": "0.1.0",
  "description": "Forms for Payload CMS 3: sections, steps, show/hide rules checked on the server, spam checks, attachments, email, WhatsApp and webhook delivery. No visitor UI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared": {
      "import": "./src/exports/shared.ts",
      "types": "./src/exports/shared.ts",
      "default": "./src/exports/shared.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:types && yarn build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "dev": "next dev dev --turbo",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "yarn dev:payload generate:importmap",
    "generate:types": "yarn dev:payload generate:types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "spec:validate": "cross-env OPENSPEC_TELEMETRY=0 openspec validate --all --strict",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@fission-ai/openspec": "1.16.0",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.16.22",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.92.1",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "payload": "^3.92.1"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./shared": {
        "import": "./dist/exports/shared.js",
        "types": "./dist/exports/shared.d.ts",
        "default": "./dist/exports/shared.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "packageManager": "yarn@4.18.1"
}
